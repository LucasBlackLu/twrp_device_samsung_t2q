/system                    ext4     system                                                    flags=display=system;logical
/system_ext                ext4     system_ext                                                flags=display=system_ext;logical
/product                   ext4     product                                                   flags=display=product;logical
/vendor                    ext4     vendor                                                    flags=display=vendor;logical
/odm                       ext4     odm                                                       flags=display=odm;logical
/metadata                  ext4     /dev/block/by-name/metadata                               flags=display=metadata
/cache                     ext4     /dev/block/bootdevice/by-name/cache                       flags=display=cache
/mnt/vendor/persist        ext4     /dev/block/bootdevice/by-name/persist                     flags=display=persist
/data                      f2fs     /dev/block/bootdevice/by-name/userdata                    flags=display=data
/misc                      emmc     /dev/block/bootdevice/by-name/misc                        flags=display=misc
/vendor/firmware_mnt       vfat     /dev/block/bootdevice/by-name/apnhlos                     flags=display=firmware_mnt
/vendor/firmware-modem     vfat     /dev/block/bootdevice/by-name/modem                       flags=display=firmware-modem
/mnt/vendor/efs            ext4     /dev/block/bootdevice/by-name/efs                         flags=display=efs
/efs                       ext4     /dev/block/bootdevice/by-name/sec_efs                     flags=display=efs
/vendor/dsp                ext4     /dev/block/bootdevice/by-name/dsp                         flags=display=dsp
/spu                       ext4     /dev/block/bootdevice/by-name/spu                         flags=display=spu
/storage/usbotg            vfat     /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*     flags=display=usbotg
/boot                      emmc     /dev/block/bootdevice/by-name/boot                        flags=display=boot
/recovery                  emmc     /dev/block/bootdevice/by-name/recovery                    flags=display=recovery
/storage/sdcard1           vfat     /devices/platform/soc/8804000.sdhci/mmc_host*             flags=display=sdcard1
/vendor/bt_firmware        vfat     /dev/block/bootdevice/by-name/bluetooth                   flags=display=bt_firmware
auto                       vfat     /devices/platform/soc/8804000.sdhci/mmc_host*             flags=display=auto
auto                       auto     /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*     flags=display=auto
